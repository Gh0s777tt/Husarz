# --- Husarz .gitignore ---
# Zasada bezpieczeństwa: wagi modeli, sekrety i dane NIGDY nie trafiają do repo.

# Wagi modeli i dane lokalne (suwerenność — trzymane wyłącznie lokalnie)
/models/
*.gguf
*.safetensors
*.bin
*.pt
*.onnx

# Sekrety i konfiguracja środowiska
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets/
*.age
!*.age.pub

# Dane runtime, artefakty, logi
/data/
/artifacts/
/var/
*.log
# CAŁY domyślny katalog dziennika audytu, nie wybrane wzorce nazw. Wcześniej stało tu
# `audit/*.log` + `audit/*.kotwica`, co ignorowało dokładnie dwie nazwy — a dziennik
# zarchiwizowany jako `audit.log.2026-08-28` nie pasował już do żadnego wzorca i trafiał
# do `git status` jako plik do zacommitowania. Repozytoria są PUBLICZNE, a dziennik audytu
# niesie referencje kont, nazwy akcji i ścieżki operatora; gitleaks go NIE zatrzyma, bo
# dziennik nie zawiera wzorca sekretu.
/audit/
# Pliki towarzyszące dziennikowi — na wypadek `audit.path` wskazującego POZA `/audit/`.
# To nie jest pełne zabezpieczenie i mówimy to wprost: ścieżka jest konfigurowalna, więc
# dziennik wskazany w inne miejsce repozytorium trzeba dopisać tutaj ręcznie. Wzorce niżej
# domykają to, co da się domknąć bez znajomości konfiguracji (`*.log` stoi już wyżej).
*.kotwica
*.lock

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Node / web
node_modules/
web/.next/
web/out/
web/dist/

# Narzędzia i IDE
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
# macOS na woluminach exFAT/NTFS tworzy sidecary AppleDouble (metadane, zero treści) —
# zaśmiecają repo i wywracają lintery (ruff: „stream did not contain valid UTF-8").
._*

# Portal dokumentacji (MkDocs — build wyjściowy, generowany)
/site/

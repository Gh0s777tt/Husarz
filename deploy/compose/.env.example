# ============================================================================
# deploy/compose/.env.example — zmienne dla profili prod/airgap.
# Skopiuj do deploy/compose/.env i uzupełnij BEZPIECZNIE. NIE commituj .env.
# W prod dostarczaj te wartości z Vault/SOPS (np. przez `docker compose` w CI
# z sekretami wstrzykiwanymi z managera sekretów), nie trzymaj ich w pliku.
# ============================================================================

# Domena publiczna (TLS/ingress). Powiąż z security.auth (TrustedHost) w razie potrzeby.
HUSARZ_PUBLIC_HOST=husarzai.pl

# Token API (Bearer). W configu: security.auth.api_token_ref=env:HUSARZ_API_TOKEN.
# Wygeneruj długi, losowy: `openssl rand -hex 32`.
HUSARZ_API_TOKEN=CHANGE_ME_dlugi_losowy_token

# Hasła usług danych (prod). Airgap również ich wymaga (usługi lokalne).
HUSARZ_PG_PASSWORD=CHANGE_ME
HUSARZ_REDIS_PASSWORD=CHANGE_ME
HUSARZ_MINIO_USER=husarz
HUSARZ_MINIO_PASSWORD=CHANGE_ME

# Tag obrazu husarz-api. Domyślnie wersja projektu; nadpisz przy wdrażaniu
# konkretnego wydania z rejestru.
# HUSARZ_IMAGE_TAG=0.14.0

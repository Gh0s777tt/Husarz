# ============================================================================
# .dockerignore — co NIE trafia do kontekstu obrazu.
# Twarde wymogi: żadnych wag modeli, sekretów, danych ani śmieci deweloperskich.
# ============================================================================

# Wagi modeli — nigdy w obrazie (gitignored, potencjalnie wielkie).
models/

# Sekrety i lokalne środowisko.
.env
.env.*
!.env.example
secrets/
*.key
*.pem

# Środowiska i cache Pythona.
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
build/
dist/

# Dane runtime — nie pieczemy ich w obraz.
audit/
data/
artifacts/
workspace/

# VCS i CI.
.git/
.github/
.gitlab-ci.yml

# Frontend (budowany osobno; obraz rdzenia serwuje konsolę statyczną).
web/node_modules/

# Testy, dokumentacja, wdrożenia i pakowanie — niepotrzebne w obrazie runtime.
tests/
docs/
deploy/
packaging/
*.md
!README.md

# --- Artefakty systemów plików (macOS) -------------------------------------
# Sidecary AppleDouble powstają, gdy macOS zapisuje na wolumenie bez natywnych xattr
# (exFAT/NTFS/sieciowe). Bez tego wykluczenia `docker build` PADA już przy wysyłaniu
# kontekstu: "failed to xattr ._.gitlab-ci.yml: operation not permitted" — czyli obrazu
# nie da się w ogóle zbudować z takiego wolumenu. To samo wykluczenie jest w .gitignore.
._*
.DS_Store

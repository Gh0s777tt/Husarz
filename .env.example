# ============================================================================
# Husarz — przykładowe zmienne środowiskowe (.env.example)
# ============================================================================
# Skopiuj do .env i uzupełnij. PLIK .env JEST W .gitignore — nigdy go nie commituj.
# Sekrety produkcyjne trzymaj w Vault lub SOPS/age, NIE w .env poza dev.
#
# Hierarchia konfiguracji (od najniższego do najwyższego priorytetu):
#   defaults (kod) -> config/*.yaml -> ENV (HUSARZ_*) -> sekrety -> runtime (panel)
#
# Zagnieżdżenie pól przez podwójny podkreślnik "__".
#   Przykład: HUSARZ_PLATFORM__PROFILE=airgap  nadpisze platform.profile
# ============================================================================

# --- Profil działania: dev | prod | airgap ---
HUSARZ_PLATFORM__PROFILE=dev

# --- Katalog konfiguracji (domyślnie ./config) ---
HUSARZ_CONFIG_DIR=./config

# --- Poziom logowania: DEBUG | INFO | WARNING | ERROR ---
HUSARZ_PLATFORM__LOG_LEVEL=INFO

# --- Bezpieczeństwo: domyślnie deny-all egress (nie zmieniaj bez powodu) ---
HUSARZ_SECURITY__EGRESS__DEFAULT_POLICY=deny

# --- Token API (Bearer) dla REST API/konsoli ---
# W configu podaj REFERENCJĘ (security.auth.api_token_ref = env:HUSARZ_API_TOKEN);
# poniżej faktyczna wartość sekretu (WYMAGANE przy nasłuchu poza 127.0.0.1).
# HUSARZ_API_TOKEN=CHANGE_ME_dlugi_losowy_token

# --- Przykładowe referencje do sekretów (NIE wpisuj tu prawdziwych wartości) ---
# Wartości pobierane przez dostawcę sekretów (Vault/SOPS). To tylko wskaźniki.
# HUSARZ_SECRETS_PROVIDER=none            # none | env | vault | sops
# VAULT_ADDR=https://vault.example.local:8200
# VAULT_TOKEN=CHANGE_ME                   # tylko lokalnie/dev; w prod użyj auth method

# --- Przykładowe endpointy modeli (nadpisania; domyślne w config/models.yaml) ---
# HUSARZ_MODELS__REGISTRY__glm-main__endpoint=http://localhost:8000/v1
# HUSARZ_MODELS__REGISTRY__bielik__endpoint=http://localhost:11434/v1
